# ─────────────────────────────────────────────────────────────────────────────
# Omarchy (Linux): manual-migration mode.
# Everything listed in .chezmoidata/omarchy.yaml (omarchyIgnoreList) is NOT
# managed on Omarchy; anything NOT listed (e.g. ~/.config/mihoro.toml) is.
# To adopt a file on Omarchy, remove its line from that list.
# ─────────────────────────────────────────────────────────────────────────────
{{- if and (hasKey . "omarchy") .omarchy -}}
{{- range .omarchyIgnoreList }}
{{ . }}
{{- end }}
{{- end }}

# Headless/server exclusions (no GUI, reserved for future use)
# ─────────────────────────────────────────────────────────────────────────────
{{- if .headless }}
# GUI apps (not needed on headless servers)
.config/aerospace/
.config/borders/
.config/karabiner/
.config/ghostty/
.config/hammerspoon/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Encryption-related exclusions (skip when useEncryption is false)
# ─────────────────────────────────────────────────────────────────────────────
{{- if not .useEncryption }}
.chezmoiscripts/01_setup-encryption-key.sh
.ssh/*
.config/omnyssh/hosts.toml
{{- end }}
