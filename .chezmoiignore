# ─────────────────────────────────────────────────────────────────────────────
# Omarchy (Linux): manual-migration mode.
# Everything listed in .chezmoidata/omarchy.yaml (omarchyIgnoreList) is NOT
# managed on Omarchy; anything NOT listed (e.g. ~/.config/mihoro.toml) is.
# To adopt a file on Omarchy, remove its line from that list.
# ─────────────────────────────────────────────────────────────────────────────
{{- if and (hasKey . "omarchy") .omarchy -}}
{{- range .omarchyIgnoreList }}
{{ . }}
{{- end }}
{{- end }}

# Fcitx5/Rime, Hyprland input, Foot terminal defaults, Bash-to-Fish
# bootstrap, UWSM environment overrides, and Omarchy-specific Aqua/Codex
# glue are managed only on Omarchy. Pi and Herdr wrappers are shared.
{{- if not (and (hasKey . "omarchy") .omarchy) }}
.config/fcitx5/
.local/share/fcitx5/
.config/hypr/input.lua
.config/hypr/bindings.lua
.config/foot/
.config/uwsm/
.config/aquaproj-aqua/aqua-omarchy.yaml
# MSIME's Omarchy theme hook points at /usr/share/msime-client, which only
# exists where the AUR package is installed (Omarchy).
.config/omarchy/hooks/theme-set.d/
# The MSIME preferences are patched by a modify_ script, so they are only
# meaningful where the addon exists.
.config/msime-client/preferences.json
.local/bin/codex
.local/bin/gh
.bashrc
{{- end }}

# EasyTier: the encrypted node configuration belongs to the macOS office-server,
# which owns the mesh's LAN subnet exports. The Omarchy host is no longer an
# EasyTier node, so both the node config and its launchd unit are managed only
# there.
.config/systemd/user/easytier.service
{{- if not (and (eq .chezmoi.os "darwin") (eq .machineProfile "office-server")) }}
.config/easytier/
Library/LaunchAgents/io.easytier.core.plist
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────────────
# macOS: mihomo (fork kernel) is Linux-only (macOS uses Surge)
# ─────────────────────────────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
.config/mihomo/
.config/systemd/
{{- end }}

# Headless/server exclusions (no GUI, reserved for future use)
# ─────────────────────────────────────────────────────────────────────────────
{{- if .headless }}
# GUI apps (not needed on headless servers)
.config/aerospace/
.config/borders/
.config/karabiner/
.config/ghostty/
.config/hammerspoon/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# OmniWM is the macOS window manager; its settings are macOS-only.
# ─────────────────────────────────────────────────────────────────────────────
{{- if ne .chezmoi.os "darwin" }}
.config/omniwm/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# oh-my-pi (the Pi fork) was removed from Aqua; Tern installs and updates its
# binary outside this repository. Pi and omp config files are managed on both
# platforms by chezmoi modify_ scripts, which assert only the UI, tool and
# package keys owned here; model providers, model roles and thinking strength
# are written by Magpie and preserved as-is, except modelRoles.designer, which
# is pinned here because magpie omp has no designer field.
# ─────────────────────────────────────────────────────────────────────────────

# Web clients and the Web UI's mise Node shim are office-server-only.
{{- if ne .machineProfile "office-server" }}
.config/roamgate/
.config/herdr/plugins/config/devswha.herdr-web-ui/
.local/bin/node
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Encryption-related exclusions (skip when useEncryption is false)
# ─────────────────────────────────────────────────────────────────────────────
{{- if not .useEncryption }}
.chezmoiscripts/01_setup-encryption-key.sh
.ssh/*
.config/omnyssh/hosts.toml
{{- end }}
