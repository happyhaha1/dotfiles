# ─────────────────────────────────────────────────────────────────────────────
# Omarchy (Linux): manual-migration mode.
# Everything listed in .chezmoidata/omarchy.yaml (omarchyIgnoreList) is NOT
# managed on Omarchy; anything NOT listed (e.g. ~/.config/mihoro.toml) is.
# To adopt a file on Omarchy, remove its line from that list.
# ─────────────────────────────────────────────────────────────────────────────
{{- if and (hasKey . "omarchy") .omarchy -}}
{{- range .omarchyIgnoreList }}
{{ . }}
{{- end }}
{{- end }}

# Fcitx5/Rime, Hyprland input, Foot terminal defaults, Bash-to-Fish
# bootstrap, UWSM environment overrides, and Omarchy-specific Aqua/Codex/Pi
# glue (except the shared Herdr wrapper) are managed only on Omarchy.
{{- if not (and (hasKey . "omarchy") .omarchy) }}
.config/fcitx5/
.local/share/fcitx5/
.config/hypr/input.lua
.config/hypr/bindings.lua
.config/foot/
.config/uwsm/
.config/aquaproj-aqua/aqua-omarchy.yaml
.local/bin/codex
.local/bin/gh
.local/bin/pi
.bashrc
{{- end }}

# EasyTier is managed only on Omarchy/Linux; do not adopt its encrypted
# machine-specific configuration or user service on other targets.
{{- if not (and (hasKey . "omarchy") .omarchy) }}
.config/easytier/
.config/systemd/user/easytier.service
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────────────
# macOS: mihomo (fork kernel) is Linux-only (macOS uses Surge)
# ─────────────────────────────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
.config/mihomo/
.config/systemd/
{{- end }}

# Headless/server exclusions (no GUI, reserved for future use)
# ─────────────────────────────────────────────────────────────────────────────
{{- if .headless }}
# GUI apps (not needed on headless servers)
.config/aerospace/
.config/borders/
.config/karabiner/
.config/ghostty/
.config/hammerspoon/
{{- end }}

# Roamgate is enabled only for the office-server profile for now.
{{- if ne .machineProfile "office-server" }}
.config/roamgate/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Encryption-related exclusions (skip when useEncryption is false)
# ─────────────────────────────────────────────────────────────────────────────
{{- if not .useEncryption }}
.chezmoiscripts/01_setup-encryption-key.sh
.ssh/*
.config/omnyssh/hosts.toml
{{- end }}
