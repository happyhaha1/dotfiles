# Generated by chezmoi from .chezmoidata/homebrew.yaml.
# Keep this file limited to macOS software that is not already provided by
# Aqua, mise, or the macOS base system. Shared entries apply to every Mac;
# profile entries apply only to the selected machine profile.

{{- $machineProfile := "other" -}}
{{- if hasKey . "machineProfile" -}}
{{-   $machineProfile = .machineProfile -}}
{{- end -}}

{{- range .homebrew.taps.shared }}
tap "{{ . }}"
{{- end }}
{{- if and (hasKey .homebrew.taps "profiles") (hasKey .homebrew.taps.profiles $machineProfile) }}
{{- range index .homebrew.taps.profiles $machineProfile }}
tap "{{ . }}"
{{- end }}
{{- end }}

{{- range .homebrew.brews.shared }}
brew "{{ . }}"
{{- end }}
{{- if and (hasKey .homebrew.brews "profiles") (hasKey .homebrew.brews.profiles $machineProfile) }}
{{- range index .homebrew.brews.profiles $machineProfile }}
brew "{{ . }}"
{{- end }}
{{- end }}

{{- range .homebrew.casks.shared }}
cask "{{ . }}"
{{- end }}
{{- if and (hasKey .homebrew.casks "profiles") (hasKey .homebrew.casks.profiles $machineProfile) }}
{{- range index .homebrew.casks.profiles $machineProfile }}
cask "{{ . }}"
{{- end }}
{{- end }}

{{- if .installMasApps }}
{{- range .homebrew.masApps.shared }}
mas "{{ index . 0 }}", id: {{ index . 1 }}
{{- end }}
{{- if and (hasKey .homebrew.masApps "profiles") (hasKey .homebrew.masApps.profiles $machineProfile) }}
{{- range index .homebrew.masApps.profiles $machineProfile }}
mas "{{ index . 0 }}", id: {{ index . 1 }}
{{- end }}
{{- end }}
{{- end }}
