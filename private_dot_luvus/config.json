{
  "version": 2,
  "theme": "terminal",
  "language": "zh",
  "shell": "default",
  "sidebar_width": 26,
  "sidebars": null,
  "layout": {
    "col_gap": 1,
    "row_gap": 0,
    "show_titles": true,
