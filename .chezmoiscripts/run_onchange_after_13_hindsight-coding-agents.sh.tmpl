#!/bin/sh
# Agent-tooling bootstrap, run after the aqua step: stages the shared
# Hindsight coding-agent runtime and wires its pi extension + skill, then
# makes sure omp has the Magic Context plugin for the context plane. The
# connection config (~/.hindsight/coding-agent.json) and the Magic Context
# config (~/.config/cortexkit/magic-context.jsonc) are managed separately
# as encrypted chezmoi sources. Every step is idempotent.
set -eu

npx -y @vectorize-io/hindsight-coding-agents@latest install pi

# Magic Context for omp: skip when already installed so a re-run does not
# re-download the package on every apply.
if ! omp plugin list --json 2>/dev/null | grep -q '"@cortexkit/pi-magic-context"'; then
    omp plugin install @cortexkit/pi-magic-context
fi
omp config set compaction.enabled false >/dev/null
omp config set memory.backend off >/dev/null
