#!/bin/sh
# Ensure the age binary is available before chezmoi applies encrypted files.
# The command wrapper used by .chezmoi.toml performs the same check while
# reading source state; this script keeps the executable on PATH afterwards.

set -eu

echo ":: [01] Ensuring age is available"

info() { printf '\033[1;32minfo:\033[0m %s\n' "$1" >&2; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$1" >&2; }

ensure_age() {
    if command -v age >/dev/null 2>&1; then
        info "age already available: $(command -v age)"
        return
    fi

    if command -v brew >/dev/null 2>&1; then
        info "installing age via Homebrew..."
        brew install age || warn "failed to install age via Homebrew"
    elif command -v omarchy-pkg-add >/dev/null 2>&1; then
        info "installing age via omarchy pkg add..."
        omarchy-pkg-add age || warn "failed to install age via omarchy pkg add"
    elif command -v pacman >/dev/null 2>&1; then
        info "installing age via pacman..."
        sudo pacman -S --needed --noconfirm age || warn "failed to install age via pacman"
    fi

    # Make age findable on the default PATH for chezmoi's own process. The
    # Homebrew prefix may not be on PATH until the shell config is applied.
    if ! command -v age >/dev/null 2>&1; then
        for candidate in /opt/homebrew/bin/age /usr/local/bin/age; do
            if [ -x "$candidate" ]; then
                if sudo ln -sf "$candidate" /usr/local/bin/age; then
                    info "linked /usr/local/bin/age -> $candidate"
                else
                    warn "could not symlink age into /usr/local/bin"
                fi
                break
            fi
        done
    fi

    if ! command -v age >/dev/null 2>&1; then
        warn "age is still not available; encrypted (.age) files will fail to apply"
    fi
}

ensure_age
