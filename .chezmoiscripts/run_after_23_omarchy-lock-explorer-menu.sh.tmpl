#!/usr/bin/env bash
set -euo pipefail

echo ":: [23] Lock-explorer menu entry"

{{ if not (and (hasKey . "omarchy") .omarchy) }}
echo "    Skipped (not an Omarchy machine)"
exit 0
{{- else }}
# Changing the plugin declaration or this script reruns the menu-entry install.
# plugin: io.github.sirjul1337.lock-explorer

if ! command -v omarchy >/dev/null 2>&1; then
    echo "    Skipped (omarchy command not found)"
    exit 0
fi

# Omarchy's plugin commands talk to omarchy-shell over IPC, which needs the
# distro path even in non-login apply shells (herdr, ssh, cron).
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

plugin_id="io.github.sirjul1337.lock-explorer"
plugin_dir="$HOME/.config/omarchy/plugins/$plugin_id"
install_sh="$plugin_dir/extras/install.sh"

# The plugin must exist first: run_after_21 installs it, and its id must be
# declared in .chezmoidata/omarchy.yaml, otherwise a manual install would be
# pruned on the next apply.
declared="$(omarchy plugin list --json 2>/dev/null | jq -r --arg id "$plugin_id" 'map(select(.id == $id)) | length')"
if [[ "$declared" -eq 0 ]]; then
    echo "    Skipped ($plugin_id is not installed; apply again after run_after_21)"
    exit 0
fi

if [[ ! -x "$install_sh" ]]; then
    echo "    Error: $install_sh not found or not executable" >&2
    exit 1
fi

# Idempotent: the script prints installed/missing and exits early when the
# launcher, icon, and Omarchy menu entry are already in place.
if "$install_sh" --status | grep -q installed; then
    echo "    Menu entry already installed"
else
    echo "    Installing launcher, icon, and Omarchy menu entry"
    "$install_sh"
fi
{{ end }}
