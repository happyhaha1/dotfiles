#!/usr/bin/env bash
set -euo pipefail

echo ":: [12] Synchronizing Omarchy packages"

{{ if not (and (hasKey . "omarchy") .omarchy) }}
echo "    Skipped (not an Omarchy machine)"
exit 0
{{- else }}
{{ $profile := joinPath .chezmoi.sourceDir "private_dot_config/fcitx5/private_profile.tmpl" -}}
{{ $fcitxConfig := joinPath .chezmoi.sourceDir "private_dot_config/fcitx5/private_config" -}}
{{ $classicUIConfig := joinPath .chezmoi.sourceDir "private_dot_config/fcitx5/conf/private_classicui.conf" -}}
{{- $machineProfile := "other" -}}
{{- if hasKey . "machineProfile" -}}
{{-   $machineProfile = .machineProfile -}}
{{- end -}}
# Changing the package list, machine profile, or any managed Fcitx file reruns this script.
# machine profile: {{ $machineProfile }}
# profile: {{ if stat $profile }}{{ output "sha256sum" $profile | trim }}{{ else }}n/a{{ end }}
# fcitx config: {{ if stat $fcitxConfig }}{{ output "sha256sum" $fcitxConfig | trim }}{{ else }}n/a{{ end }}
# Classic UI config: {{ if stat $classicUIConfig }}{{ output "sha256sum" $classicUIConfig | trim }}{{ else }}n/a{{ end }}

packages=(
{{ range .omarchyPackages.shared }}    {{ . | quote }}
{{ end }}{{ if and (hasKey .omarchyPackages "profiles") (hasKey .omarchyPackages.profiles $machineProfile) }}{{ range index .omarchyPackages.profiles $machineProfile }}    {{ . | quote }}
{{ end }}{{ end }})

aur_packages=(
{{ range .omarchyAurPackages.shared }}    {{ . | quote }}
{{ end }}{{ if and (hasKey .omarchyAurPackages "profiles") (hasKey .omarchyAurPackages.profiles $machineProfile) }}{{ range index .omarchyAurPackages.profiles $machineProfile }}    {{ . | quote }}
{{ end }}{{ end }})

if ! command -v omarchy >/dev/null 2>&1; then
    echo "    Error: omarchy command not found" >&2
    exit 1
fi

# omarchy pkg does not record who owns an installed package. Keep a local
# manifest of the packages declared by this repository, then reconcile only
# entries that were present in the previous manifest. This leaves unrelated
# manually installed packages untouched.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
state_file="$state_dir/omarchy-packages"
aur_state_file="$state_dir/omarchy-aur-packages"
state_tmp=""
aur_state_tmp=""
cleanup() {
    [[ -z "$state_tmp" ]] || rm -f "$state_tmp"
    [[ -z "$aur_state_tmp" ]] || rm -f "$aur_state_tmp"
}
trap cleanup EXIT

declare -A desired=()
for pkg in "${packages[@]}"; do
    [[ -n "$pkg" ]] && desired["$pkg"]=1
done

declare -A desired_aur=()
for pkg in "${aur_packages[@]}"; do
    [[ -n "$pkg" ]] && desired_aur["$pkg"]=1
done

declare -A previous=()
if [[ -f "$state_file" ]]; then
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] && previous["$pkg"]=1
    done < "$state_file"
fi

declare -A previous_aur=()
if [[ -f "$aur_state_file" ]]; then
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] && previous_aur["$pkg"]=1
    done < "$aur_state_file"
fi

# Never infer ownership from pacman's explicit/dependency reason. Protect both
# Omarchy ISO manifests when deciding which removed entries may be dropped.
base_manifest_available=true
# These package names are Omarchy's own meta/config packages but are not
# repeated in the ISO package lists themselves.
declare -A omarchy_base=(
    [omarchy]=1
    [omarchy-keyring]=1
    [omarchy-settings]=1
)
for manifest in \
    /usr/share/omarchy/install/omarchy-base.packages \
    /usr/share/omarchy/install/omarchy-other.packages; do
    if [[ ! -r "$manifest" ]]; then
        base_manifest_available=false
        continue
    fi
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] && omarchy_base["$pkg"]=1
    done < <(sed -E 's/[[:space:]]*#.*$//' "$manifest" | awk 'NF { print $1 }')
done

declare -A removed_set=()
for pkg in "${!previous[@]}"; do
    if [[ -z ${desired[$pkg]+x} && -z ${desired_aur[$pkg]+x} && -z ${omarchy_base[$pkg]+x} ]]; then
        removed_set["$pkg"]=1
    fi
done
for pkg in "${!previous_aur[@]}"; do
    if [[ -z ${desired[$pkg]+x} && -z ${desired_aur[$pkg]+x} && -z ${omarchy_base[$pkg]+x} ]]; then
        removed_set["$pkg"]=1
    fi
done

removed=()
if ((${#removed_set[@]} > 0)); then
    mapfile -t removed < <(printf '%s\n' "${!removed_set[@]}" | sort -u)
fi

if ((${#removed[@]} > 0)); then
    if [[ "$base_manifest_available" != true ]]; then
        echo "    Error: Omarchy base manifests are unavailable; refusing package cleanup" >&2
        exit 1
    fi
    echo "    Removing no-longer-managed packages: ${removed[*]}"
    omarchy pkg drop "${removed[@]}"
fi

if ((${#packages[@]} > 0)); then
    echo "    Ensuring declared packages: ${packages[*]}"
    omarchy pkg add "${packages[@]}"
else
    echo "    No official Omarchy packages declared"
fi

if ((${#aur_packages[@]} > 0)); then
    echo "    Ensuring declared AUR packages: ${aur_packages[*]}"
    omarchy pkg aur add "${aur_packages[@]}"
else
    echo "    No AUR packages declared"
fi

# MSIME (水杉输入法) keeps its dictionaries and runtime state outside the
# repository, so prepare them once here. --no-register is mandatory: the Fcitx5
# input method list belongs to private_profile.tmpl, and letting the setup tool
# write it would make every `chezmoi apply` fight the last registration.
# Network access may be unavailable, so a failure is reported but never fatal.
{{ if .omarchyInputMethod.msime.downloadDictionaries -}}
msime_args=(--download)
{{- else }}
msime_args=()
{{- end }}
msime_state="${XDG_CONFIG_HOME:-$HOME/.config}/msime-client"
if [[ -n ${desired_aur[msime-bin]+x} ]] && command -v msime-linux-setup >/dev/null 2>&1; then
    if [[ -d "$msime_state" ]]; then
        msime-linux-setup --update --no-register ${msime_args[@]+"${msime_args[@]}"} \
            || echo "    Warning: MSIME dictionary update failed; existing dictionaries are kept"
    else
        msime-linux-setup --no-register ${msime_args[@]+"${msime_args[@]}"} \
            || echo "    Warning: MSIME first-time setup failed; run msime-linux-setup manually"
    fi
elif [[ -z ${desired_aur[msime-bin]+x} && -d "$msime_state" ]]; then
    echo "    Note: MSIME is no longer declared but $msime_state exists"
    echo "          Run msime-linux-setup --unregister before deleting that directory"
fi

# msime-linux-setup also links its bar widget into ~/.config/omarchy/plugins.
# Omarchy starts Fcitx5 with --disable notificationitem, so the tray that would
# show MSIME's 中/英 label never appears; this widget stands in for it. Copy the
# package's widget as a real directory (the setup tool's symlink is replaced, and
# run_after_21 prunes anything undeclared) and keep it declared as a local
# plugin in .chezmoidata/omarchy.yaml.
msime_plugin_src=/usr/share/msime-client/omarchy/plugin
msime_plugin_dst="$HOME/.config/omarchy/plugins/metasequoia.msime"
if [[ -f "$msime_plugin_src/manifest.json" ]]; then
    if [[ -L "$msime_plugin_dst" ]]; then
        rm -f "$msime_plugin_dst"
    fi
    if ! diff -rq "$msime_plugin_src" "$msime_plugin_dst" >/dev/null 2>&1; then
        rm -rf "$msime_plugin_dst"
        mkdir -p "$(dirname "$msime_plugin_dst")"
        cp -r "$msime_plugin_src" "$msime_plugin_dst" \
            || echo "    Warning: could not install the MSIME bar widget"
        # The shell rescans on its own schedule; ask for a rescan so
        # run_after_21 discovers the plugin without waiting on a timer.
        if command -v omarchy-shell >/dev/null 2>&1; then
            omarchy-shell -q shell rescanPlugins || true
        fi
    fi
fi

# Record ownership only after removal and both installation operations succeed.
# These machine-local files are intentionally not part of the dotfiles repo.
install -d -m 700 "$state_dir"
state_tmp=$(mktemp "$state_dir/omarchy-packages.XXXXXX")
aur_state_tmp=$(mktemp "$state_dir/omarchy-aur-packages.XXXXXX")
chmod 600 "$state_tmp" "$aur_state_tmp"
if ((${#packages[@]} > 0)); then
    printf '%s\n' "${packages[@]}" | sort -u > "$state_tmp"
fi
if ((${#aur_packages[@]} > 0)); then
    printf '%s\n' "${aur_packages[@]}" | sort -u > "$aur_state_tmp"
fi
mv -f "$state_tmp" "$state_file"
state_tmp=""
mv -f "$aur_state_tmp" "$aur_state_file"
aur_state_tmp=""

fcitx_bus_ready() {
    # Query the bus without calling fcitx5-remote. The latter can trigger the
    # D-Bus activated fallback service while the Omarchy unit is still starting.
    command -v busctl >/dev/null 2>&1 \
        && busctl --user status org.fcitx.Fcitx5 >/dev/null 2>&1
}

wait_for_fcitx() {
    for _ in {1..30}; do
        if fcitx_bus_ready; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

# The unit state, not the bus name, decides whether a restart worked: a
# transient instance can own org.fcitx.Fcitx5 while the Omarchy unit is failed.
wait_for_fcitx_unit() {
    for _ in {1..30}; do
        systemctl --user is-active --quiet omarchy-fcitx5.service && return 0
        sleep 0.1
    done
    return 1
}

stop_dbus_activated_fcitx() {
    local unit
    while IFS= read -r unit; do
        [[ -n "$unit" ]] || continue
        echo "    Stopping competing D-Bus activated Fcitx5 unit: $unit"
        systemctl --user stop "$unit" >/dev/null 2>&1 || true
    done < <(
        systemctl --user list-units --all --type=service --no-legend --no-pager \
            | awk '$1 ~ /^dbus-.*org\\.fcitx\\.Fcitx5/ { print $1 }'
    )
}

select_input_method() {
    local target="$1"

    command -v fcitx5-remote >/dev/null 2>&1 || return 1
    fcitx_bus_ready || return 1

    # systemd may report the service started just before its DBus name is
    # available, so retry briefly before giving up.
    for _ in {1..20}; do
        if fcitx5-remote -s "$target" >/dev/null 2>&1 \
            && [[ "$(fcitx5-remote -n 2>/dev/null)" == "$target" ]]; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

# Rime is retired on this machine: the engine, its schemas and the overrides are
# no longer declared. `omarchy pkg drop` removes the packages but leaves the
# engine's state directory (user dictionary, build cache, sync) behind, so clear
# it once the package is really gone. The curated overrides are kept in the
# repository under docs/backup/rime and are deliberately not installed.
retired_rime_dir="$HOME/.local/share/fcitx5/rime"
if [[ -d "$retired_rime_dir" ]] && ! pacman -Qq fcitx5-rime >/dev/null 2>&1; then
    echo "    Removing retired Rime state: $retired_rime_dir"
    rm -rf "$retired_rime_dir"
fi

# A D-Bus activation can race the Omarchy unit after it was stopped. Remove
# transient fallback units first, then wait for the intended service to own the
# name before sending any fcitx5-remote command (which otherwise can activate
# another instance).
stop_dbus_activated_fcitx

# Restart the Omarchy-managed service after installation or any managed config
# change. Any application that touches org.fcitx.Fcitx5 while the unit is stopped
# starts a transient D-Bus instance that keeps the bus name, so the unit exits
# immediately and systemd trips its start limit; the unit state decides whether
# the restart worked, and a failed one is recovered once.
systemctl --user restart omarchy-fcitx5.service >/dev/null 2>&1 || true
if ! wait_for_fcitx_unit; then
    echo "    Recovering Fcitx5 service after a bus-name race"
    stop_dbus_activated_fcitx
    systemctl --user reset-failed omarchy-fcitx5.service >/dev/null 2>&1 || true
    systemctl --user restart omarchy-fcitx5.service >/dev/null 2>&1 || true
    wait_for_fcitx_unit || true
fi
wait_for_fcitx || true
if systemctl --user is-active --quiet omarchy-fcitx5.service; then
    echo "    Restarted omarchy-fcitx5.service"
    fcitx5-remote -r >/dev/null 2>&1 && echo "    Reloaded the Fcitx5 configuration"
elif fcitx_bus_ready; then
    echo "    Fcitx5 runs outside the Omarchy unit; the config applies on next start"
else
    echo "    Fcitx5 service is not running; it will use the config on next start"
fi

# Select the input method declared by omarchyInputMethod.defaultIM. This has to
# read the same data value as private_profile.tmpl; selecting a fixed engine
# here would override the profile on every apply.
default_im="{{ .omarchyInputMethod.defaultIM }}"
case "$default_im" in
    msime)
        target_declared=${desired_aur[msime-bin]+x}
        ;;
    *)
        target_declared=
        ;;
esac
if [[ -n "$target_declared" ]] && select_input_method "$default_im"; then
    echo "    Selected ${default_im} as the current input method"
elif [[ -n "$target_declared" ]]; then
    echo "    Could not select ${default_im} in the current Fcitx session; it will be the default on next start"
fi
{{- end }}
