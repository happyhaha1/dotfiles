#!/bin/bash
# macOS-only Homebrew bundle.

set -euo pipefail

{{ $homebrewData := joinPath .chezmoi.sourceDir ".chezmoidata/homebrew.yaml" -}}
{{ $brewfileTemplate := joinPath .chezmoi.sourceDir "private_dot_Brewfile.tmpl" -}}
# homebrew data: {{ if stat $homebrewData }}{{ output "sha256sum" $homebrewData | trim }}{{ else }}n/a{{ end }}
# Brewfile template: {{ if stat $brewfileTemplate }}{{ output "sha256sum" $brewfileTemplate | trim }}{{ else }}n/a{{ end }}

if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "    Skipped (unsupported OS: $(uname -s); this repository targets macOS)"
    exit 0
fi

echo ":: [02] Installing Homebrew packages"

brew_cmd=""
if command -v brew >/dev/null 2>&1; then
    brew_cmd="$(command -v brew)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
    brew_cmd=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
    brew_cmd=/usr/local/bin/brew
fi

if [[ -z "$brew_cmd" ]]; then
    echo "    Skipped (Homebrew is not installed yet; install it before the next apply)"
    exit 0
fi

brewfile="$HOME/.Brewfile"
if [[ ! -f "$brewfile" ]]; then
    echo "    Skipped (generated $brewfile was not found)"
    exit 0
fi

# Trust third-party sources declared by this repository. Homebrew stores these
# entries in its trust.json rather than in a Brewfile.
HOMEBREW_NO_AUTO_UPDATE=1 "$brew_cmd" trust --tap abue-ammar/tinycast
HOMEBREW_NO_AUTO_UPDATE=1 "$brew_cmd" trust --tap steipete/tap
{{- if .work }}
HOMEBREW_NO_AUTO_UPDATE=1 "$brew_cmd" trust --tap azure/functions
{{- end }}
HOMEBREW_NO_AUTO_UPDATE=1 "$brew_cmd" trust --formula steipete/tap/remindctl

# The bundle is declarative, but must not unexpectedly upgrade unrelated tools
# during chezmoi apply. The weekly update script remains responsible for that.
HOMEBREW_NO_AUTO_UPDATE=1 "$brew_cmd" bundle install --file "$brewfile" --no-upgrade
