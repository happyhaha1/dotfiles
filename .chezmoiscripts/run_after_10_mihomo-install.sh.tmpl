#!/usr/bin/env bash
# Install the liuran001/mihomo fork kernel (smart + eBPF + Tailscale) as a
# ROOT system service, plus the zashboard web UI.
#
# Root is required: the fork's eBPF cgroup/TC programs are rejected by the
# BPF verifier for unprivileged processes ("prohibited for !root"), and
# file-capability workarounds under a systemd user service don't survive
# its capability checks.
#
# ⚠️ The kernel config is a FULL static config managed by chezmoi at
# $HOME/.config/mihomo/config.yaml — never fetch a remote subscription as
# the main config, and never replace this fork with official MetaCubeX.
set -euo pipefail

echo ":: [10] mihomo (fork kernel, system service) install"

if [[ "$(uname -s)" != "Linux" ]]; then
    echo "    Skipped (Linux only)"
    exit 0
fi

BUILD="{{ .versions.mihomoForkBuild }}"
ZASHABOARD_VERSION="{{ .versions.zashboardVersion }}"
TAG="Prerelease-Alpha"
REPO="liuran001/mihomo"
BIN="/usr/local/bin/mihomo"
CONFIG_DIR="$HOME/.config/mihomo"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
BUILD_MARKER="$CACHE_DIR/mihomo-fork-build"
CONFIG_HASH_MARKER="$CACHE_DIR/mihomo-config.sha256"
SERVICE_UNIT="/etc/systemd/system/mihomo.service"
KERNEL_CHANGED=false
CONFIG_CHANGED=false
UNIT_CHANGED=false

# --- arch / x86-64 microarch level ---
case "$(uname -m)" in
    x86_64)
        if grep -qw avx2 /proc/cpuinfo 2>/dev/null; then MARCH="amd64-v3"; else MARCH="amd64-compatible"; fi
        ;;
    aarch64) MARCH="arm64" ;;
    *)
        echo "error: unsupported architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# --- kernel: install when missing or older than the effective build ---
INSTALLED_BUILD=""
[[ -x "$BIN" ]] && INSTALLED_BUILD=$(cat "$BUILD_MARKER" 2>/dev/null || echo "unknown")

if [[ -x "$BIN" && "$INSTALLED_BUILD" == "$BUILD" ]]; then
    echo "    kernel ${BUILD} already installed, skipping download"
else
    [[ -x "$BIN" ]] || echo "    kernel binary missing — installing"

    asset_url() {
        echo "https://github.com/${REPO}/releases/download/${TAG}/mihomo-linux-${MARCH}-alpha-smart-${1}.gz"
    }

    ASSET_URL="$(asset_url "$BUILD")"
    # The rolling tag replaces assets on every build; if the pinned build is
    # gone, resolve the current one via the GitHub API. Compare the installed
    # marker again after this fallback, because the resolved build is the
    # effective version that should control whether a download is needed.
    if ! curl -fsIL -o /dev/null "${ASSET_URL}"; then
        echo "    pinned build ${BUILD} no longer present, resolving latest via GitHub API"
        BUILD=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/tags/${TAG}" \
            | grep -oE "mihomo-linux-${MARCH}-alpha-smart-[0-9a-f]+\.gz" \
            | head -1 | sed -E 's/.*smart-([0-9a-f]+)\.gz/\1/')
        if [[ -z "$BUILD" ]]; then
            echo "error: could not resolve a kernel build from ${TAG}" >&2
            exit 1
        fi
        ASSET_URL="$(asset_url "$BUILD")"
    fi

    if [[ -x "$BIN" && "$INSTALLED_BUILD" == "$BUILD" ]]; then
        echo "    kernel ${BUILD} already installed after resolving release, skipping download"
    else
        [[ "$INSTALLED_BUILD" != "$BUILD" && "$INSTALLED_BUILD" != "unknown" ]] \
            && echo "    updating kernel: ${INSTALLED_BUILD} -> ${BUILD}"
        echo "    downloading kernel build ${BUILD} (${MARCH})"
        curl -fsSL --retry 3 -o "$TMP_DIR/kernel.gz" "$ASSET_URL"
        gunzip -c "$TMP_DIR/kernel.gz" > "$TMP_DIR/mihomo"
        sudo install -m 0755 "$TMP_DIR/mihomo" "$BIN"
        mkdir -p "$CACHE_DIR"
        printf '%s\n' "$BUILD" > "$BUILD_MARKER"
        KERNEL_CHANGED=true
    fi
fi

# --- zashboard web UI -> served at http://127.0.0.1:9090/ui ---
if [[ -f "$CONFIG_DIR/ui/index.html" ]]; then
    echo "    zashboard already deployed, skipping"
else
    ZURL="https://github.com/Zephyruso/zashboard/releases/download/${ZASHABOARD_VERSION}/dist.zip"
    if [[ "$(curl -fsIL -o /dev/null -w '%{http_code}' "$ZURL" 2>/dev/null || true)" == 404 ]]; then
        echo "warn: zashboard ${ZASHABOARD_VERSION} not found, falling back to latest"
        ZURL="https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip"
    fi
    echo "    downloading zashboard ${ZASHABOARD_VERSION}"
    curl -fsSL --retry 3 -o "$TMP_DIR/dist.zip" "$ZURL"
    mkdir -p "$CONFIG_DIR/ui"
    if command -v unzip >/dev/null 2>&1; then
        unzip -oq "$TMP_DIR/dist.zip" -d "$TMP_DIR/ui"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -m zipfile -e "$TMP_DIR/dist.zip" "$TMP_DIR/ui"
    else
        echo "warn: neither unzip nor python3 available — skipping zashboard deploy" >&2
    fi
    [[ -d "$TMP_DIR/ui/dist" ]] && cp -R "$TMP_DIR/ui/dist/." "$CONFIG_DIR/ui/"
fi

# --- config change detection: restart service only when config actually changed ---
service_active=false
if systemctl is-active --quiet mihomo.service 2>/dev/null; then
    service_active=true
fi

CURRENT_CONFIG_HASH=""
if [[ -f "$CONFIG_DIR/config.yaml" ]]; then
    CURRENT_CONFIG_HASH=$(sha256sum "$CONFIG_DIR/config.yaml" | awk '{ print $1 }')
    LAST_CONFIG_HASH=$(cat "$CONFIG_HASH_MARKER" 2>/dev/null || true)
    if [[ -n "$LAST_CONFIG_HASH" ]]; then
        if [[ "$CURRENT_CONFIG_HASH" != "$LAST_CONFIG_HASH" ]]; then
            echo "    config.yaml changed since last service sync"
            CONFIG_CHANGED=true
        fi
    elif [[ "$service_active" != true ]]; then
        CONFIG_CHANGED=true
    else
        # First run after adding the marker: avoid prompting for sudo if the
        # running service is already newer than the config file.
        active_timestamp=$(systemctl show mihomo.service -p ActiveEnterTimestamp --value 2>/dev/null || true)
        active_epoch=$(date -d "$active_timestamp" +%s 2>/dev/null || echo 0)
        config_epoch=$(stat -c %Y "$CONFIG_DIR/config.yaml" 2>/dev/null || echo 0)
        if (( config_epoch > active_epoch )); then
            echo "    config.yaml is newer than the running service"
            CONFIG_CHANGED=true
        else
            echo "    config hash marker missing; initializing baseline without restart"
        fi
    fi
else
    echo "warn: mihomo config not found: $CONFIG_DIR/config.yaml" >&2
fi

# --- clean up the old user-service era (unprivileged; safe to rerun) ---
systemctl --user disable --now mihomo.service 2>/dev/null || true
rm -f "$HOME/.local/bin/mihomo"

# --- IP forwarding: required for subnet-router duty (tsnet) ---
if [[ "$(sysctl -n net.ipv4.ip_forward)" != "1" ]]; then
    echo "    enabling net.ipv4.ip_forward"
    echo 'net.ipv4.ip_forward = 1' | sudo tee /etc/sysctl.d/99-mihomo-forward.conf >/dev/null
    sudo sysctl --system >/dev/null
fi

# --- system unit (root): update only when rendered unit content changes ---
cat >"$TMP_DIR/mihomo.service" <<UNIT
[Unit]
Description=mihomo (liuran001 fork: smart + eBPF + Tailscale)
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mihomo -d ${CONFIG_DIR}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

if [[ ! -f "$SERVICE_UNIT" ]] || ! cmp -s "$TMP_DIR/mihomo.service" "$SERVICE_UNIT"; then
    UNIT_CHANGED=true
fi

if [[ "$UNIT_CHANGED" == true ]]; then
    echo "    updating systemd unit"
    sudo install -m 0644 "$TMP_DIR/mihomo.service" "$SERVICE_UNIT"
    sudo systemctl daemon-reload
fi

service_enabled=false
if systemctl is-enabled --quiet mihomo.service 2>/dev/null; then
    service_enabled=true
fi

if [[ "$service_enabled" != true ]]; then
    echo "    enabling mihomo.service"
    sudo systemctl enable mihomo.service >/dev/null
fi

if [[ "$KERNEL_CHANGED" == true || "$CONFIG_CHANGED" == true || "$UNIT_CHANGED" == true ]]; then
    echo "    restarting mihomo.service"
    sudo systemctl restart mihomo.service
elif [[ "$service_active" != true ]]; then
    echo "    starting mihomo.service"
    sudo systemctl start mihomo.service
else
    echo "    mihomo.service already current, skipping privileged service step"
fi

if [[ -n "$CURRENT_CONFIG_HASH" ]]; then
    mkdir -p "$CACHE_DIR"
    printf '%s\n' "$CURRENT_CONFIG_HASH" > "$CONFIG_HASH_MARKER"
fi

"$BIN" -v | head -1
echo ":: [10] done — dashboard: http://127.0.0.1:9090/ui"
echo "    service: sudo systemctl status mihomo | journalctl -u mihomo"
