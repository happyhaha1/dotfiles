#!/usr/bin/env bash
set -euo pipefail
{{ $machineProfile := "other" -}}
{{- if hasKey . "machineProfile" -}}
{{-   $machineProfile = .machineProfile -}}
{{- end -}}
{{- $macosOffice := and (eq .chezmoi.os "darwin") (eq $machineProfile "office-server") -}}
{{- $configSource := joinPath .chezmoi.sourceDir "private_dot_config/private_easytier/encrypted_private_easytier.toml.tmpl.age" -}}
{{- $serviceSource := joinPath .chezmoi.sourceDir "Library/LaunchAgents/io.easytier.core.plist.tmpl" -}}
{{- if not $macosOffice }}
echo ":: [13] Synchronizing EasyTier (macOS office-server only)"
echo "    Skipped (not an EasyTier target)"
exit 0
{{ else }}
echo ":: [13] Synchronizing EasyTier (macOS office-server)"

# Changing the release pin, architecture, encrypted configuration, or service
# definition reruns this installer and reconciles the service.
# version: {{ .versions.easytierVersion }}
# archive sha256: {{ .versions.easytierMacosAarch64Sha256 }}
# config source sha256: {{ if stat $configSource }}{{ output "sha256sum" $configSource | trim }}{{ else }}missing{{ end }}
# service source sha256: {{ if stat $serviceSource }}{{ output "sha256sum" $serviceSource | trim }}{{ else }}missing{{ end }}

if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "    Error: EasyTier is pinned for Darwin (found $(uname -s))" >&2
    exit 1
fi

case "$(uname -m)" in
    arm64) ;;
    *)
        echo "    Error: no EasyTier archive is pinned for $(uname -s)/$(uname -m)" >&2
        exit 1
        ;;
esac

EASYTIER_VERSION="{{ .versions.easytierVersion }}"
EASYTIER_SHA256="{{ .versions.easytierMacosAarch64Sha256 }}"
EASYTIER_ARCHIVE="easytier-macos-aarch64-${EASYTIER_VERSION}.zip"
EASYTIER_URL="https://github.com/EasyTier/EasyTier/releases/download/${EASYTIER_VERSION}/${EASYTIER_ARCHIVE}"
EASYTIER_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/easytier"
EASYTIER_VERSION_DIR="$EASYTIER_ROOT/$EASYTIER_VERSION"
EASYTIER_BIN_DIR="$HOME/.local/bin"
EASYTIER_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/easytier"
CONFIG_PATH="$HOME/.config/easytier/easytier.toml"

if [[ ! "$EASYTIER_VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "    Error: invalid EasyTier version pin: $EASYTIER_VERSION" >&2
    exit 1
fi

if [[ ! "$EASYTIER_SHA256" =~ ^[0-9a-fA-F]{64}$ ]]; then
    echo "    Error: invalid EasyTier SHA-256 pin" >&2
    exit 1
fi

install -d -m 755 "$EASYTIER_ROOT" "$EASYTIER_BIN_DIR"
install -d -m 700 "$EASYTIER_STATE_DIR"

binaries=(easytier-core easytier-cli easytier-web easytier-web-embed)

if [[ -f "$EASYTIER_VERSION_DIR/.archive.sha256" ]] \
    && grep -Fqx "$EASYTIER_SHA256" "$EASYTIER_VERSION_DIR/.archive.sha256"; then
    for binary in "${binaries[@]}"; do
        if [[ ! -x "$EASYTIER_VERSION_DIR/$binary" ]]; then
            echo "    Error: EasyTier ${EASYTIER_VERSION} is incomplete; reinstalling" >&2
            rm -rf -- "$EASYTIER_VERSION_DIR"
            break
        fi
    done
fi

if [[ -f "$EASYTIER_VERSION_DIR/.archive.sha256" ]] \
    && grep -Fqx "$EASYTIER_SHA256" "$EASYTIER_VERSION_DIR/.archive.sha256"; then
    echo "    EasyTier ${EASYTIER_VERSION} is already installed"
else
    tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/easytier.XXXXXX")"
    stage_dir=""
    cleanup() {
        rm -rf -- "$tmp_dir"
        [[ -z "$stage_dir" ]] || rm -rf -- "$stage_dir"
    }
    trap cleanup EXIT

    archive_path="$tmp_dir/$EASYTIER_ARCHIVE"
    local_archive="$HOME/Downloads/$EASYTIER_ARCHIVE"
    if [[ -f "$local_archive" ]]; then
        echo "    Using existing release archive: $local_archive"
        cp "$local_archive" "$archive_path"
    else
        echo "    Downloading ${EASYTIER_VERSION}"
        curl -fsSL --retry 3 -o "$archive_path" "$EASYTIER_URL"
    fi

    actual_sha256="$(sha256sum "$archive_path" | awk '{print $1}')"
    # macOS ships bash 3.2, which has no lowercase parameter expansion.
    expected_sha256="$(printf '%s' "$EASYTIER_SHA256" | tr '[:upper:]' '[:lower:]')"
    actual_sha256="$(printf '%s' "$actual_sha256" | tr '[:upper:]' '[:lower:]')"
    if [[ "$actual_sha256" != "$expected_sha256" ]]; then
        echo "    Error: EasyTier archive checksum mismatch" >&2
        echo "    expected: $expected_sha256" >&2
        echo "    actual:   $actual_sha256" >&2
        exit 1
    fi

    mkdir "$tmp_dir/unpacked"
    unzip -q "$archive_path" -d "$tmp_dir/unpacked"
    release_dir="$tmp_dir/unpacked/easytier-macos-aarch64"
    if [[ ! -d "$release_dir" ]]; then
        echo "    Error: EasyTier archive has an unexpected layout" >&2
        exit 1
    fi
    for binary in "${binaries[@]}"; do
        if [[ ! -f "$release_dir/$binary" ]]; then
            echo "    Error: EasyTier archive is missing $binary" >&2
            exit 1
        fi
    done

    stage_dir="$(mktemp -d "$EASYTIER_ROOT/.${EASYTIER_VERSION}.XXXXXX")"
    for binary in "${binaries[@]}"; do
        install -m 0755 "$release_dir/$binary" "$stage_dir/$binary"
    done
    printf '%s\n' "$EASYTIER_SHA256" > "$stage_dir/.archive.sha256"

    rm -rf -- "$EASYTIER_VERSION_DIR"
    mv "$stage_dir" "$EASYTIER_VERSION_DIR"
    stage_dir=""
    echo "    Installed EasyTier ${EASYTIER_VERSION}"
fi

# Keep stable command paths while retaining the versioned release directory.
for binary in "${binaries[@]}"; do
    link_tmp="$EASYTIER_BIN_DIR/.${binary}.link.$$"
    rm -f -- "$link_tmp"
    ln -s "$EASYTIER_VERSION_DIR/$binary" "$link_tmp"
    # BSD mv has no -T; every destination here is an existing file symlink.
    mv -f "$link_tmp" "$EASYTIER_BIN_DIR/$binary"
done

version_output="$($EASYTIER_BIN_DIR/easytier-core --version 2>&1)"
if ! grep -Fq "easytier-core ${EASYTIER_VERSION#v}" <<<"$version_output"; then
    echo "    Error: installed EasyTier version check failed" >&2
    echo "    output: $version_output" >&2
    exit 1
fi

if [[ ! -f "$CONFIG_PATH" ]]; then
    echo "    Error: EasyTier configuration is missing: $CONFIG_PATH" >&2
    exit 1
fi
"$EASYTIER_BIN_DIR/easytier-core" --config-file "$CONFIG_PATH" --check-config

# launchd caches a job definition at bootstrap time, so a changed agent needs a
# bootout/bootstrap cycle. bootout is asynchronous: wait until both the job and
# the previous process are gone before bootstrapping again.
launchd_label="io.easytier.core"
launchd_plist="$HOME/Library/LaunchAgents/$launchd_label.plist"
launchd_domain="gui/$(id -u)"

install -d -m 755 "$HOME/Library/Logs"

if [[ ! -f "$launchd_plist" ]]; then
    echo "    Error: launchd agent is missing: $launchd_plist" >&2
    exit 1
fi

if launchctl print "$launchd_domain/$launchd_label" >/dev/null 2>&1; then
    echo "    Unloading $launchd_label"
    launchctl bootout "$launchd_domain/$launchd_label" >/dev/null 2>&1 || true
    unloaded=false
    for _ in $(seq 1 40); do
        if ! launchctl print "$launchd_domain/$launchd_label" >/dev/null 2>&1 \
            && ! pgrep -x easytier-core >/dev/null 2>&1; then
            unloaded=true
            break
        fi
        sleep 0.25
    done
    if [[ "$unloaded" != true ]]; then
        echo "    Error: $launchd_label is still loaded after bootout" >&2
        exit 1
    fi
fi

echo "    Loading $launchd_label"
launchctl bootstrap "$launchd_domain" "$launchd_plist"
launchctl enable "$launchd_domain/$launchd_label" >/dev/null 2>&1 || true

sleep 2
if ! pgrep -x easytier-core >/dev/null 2>&1; then
    echo "    Warning: easytier-core is not running yet; see $HOME/Library/Logs/easytier.err.log" >&2
fi
{{ end -}}
