# just is a command runner, Justfile is very similar to Makefile, but simpler.

set shell := ['bash', '-euo', 'pipefail', '-c']

hostname := `hostname -s`

# List all the just commands
default:
    @just --list

############################################################################
#
#  Chezmoi related commands
#
############################################################################

# Apply chezmoi changes
[group('chezmoi')]
apply:
    chezmoi apply

# Edit chezmoi managed files
[group('chezmoi')]
edit file:
    chezmoi edit {{ "{{file}}" }}

# Show chezmoi diff
[group('chezmoi')]
diff:
    chezmoi diff

# Update chezmoi and apply
[group('chezmoi')]
update:
    chezmoi update

# Re-add modified files to chezmoi
[group('chezmoi')]
re-add:
    chezmoi re-add

# Install the declared Homebrew packages, casks, fonts, and App Store apps
[group('packages')]
bundle:
    brew bundle install --file="$HOME/.Brewfile"

# Install pinned Aqua tools
[group('packages')]
aqua-install:
    aqua install

# Remove Aqua package versions not used within the retention window.
# Override with AQUA_VACUUM_DAYS (default: 7).
[group('packages')]
aqua-clean:
    aqua vacuum --init
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum

# Install language runtimes and tools declared by mise
[group('packages')]
mise-install:
    mise install

############################################################################
#
#  Development commands
#
############################################################################

# Format chezmoi source files with treefmt
[group('dev')]
fmt:
    cd "$HOME/.local/share/chezmoi" && treefmt

# Run pre-commit checks when a local repository config is present.
# The pull-request workflow remains the authoritative portable check.
[group('dev')]
check:
    if [[ -f .pre-commit-config.yaml ]]; then pre-commit run --all-files; else echo 'No .pre-commit-config.yaml; use the CI checks.'; fi

############################################################################
#
#  Git related commands
#
############################################################################

# Git status
[group('git')]
st:
    git status

# Git diff
[group('git')]
gd:
    git diff

# Git log with graph
[group('git')]
gl:
    git log --oneline --graph --decorate -20

# Commit all changes with message
[group('git')]
cm message:
    git add -A && git commit -m "{{ "{{message}}" }}"

# Push to remote
[group('git')]
push:
    git push

# Pull from remote
[group('git')]
pull:
    git pull --rebase

############################################################################
#
#  Utility commands
#
############################################################################

# Show system info
[group('utils')]
info:
    @echo "Hostname: {{ "{{hostname}}" }}"
    @echo "OS: $(uname -s)"
    @echo "Arch: $(uname -m)"
    @brew --version 2>/dev/null || true
    @aqua --version 2>/dev/null || true
    @mise --version 2>/dev/null || true

# Check chezmoi data, encryption prerequisites, package managers, and local state.
# Set DOTFILES_DOCTOR_DIFF=1 to include a non-mutating chezmoi diff check.
[group('utils')]
doctor:
    #!/usr/bin/env bash
    set -uo pipefail
    failures=0
    warnings=0

    ok() { printf 'OK   %s\n' "$1"; }
    warn() { warnings=$((warnings + 1)); printf 'WARN %s\n' "$1"; }
    fail() { failures=$((failures + 1)); printf 'FAIL %s\n' "$1"; }
    need_cmd() {
        if command -v "$1" >/dev/null 2>&1; then
            ok "$1: $(command -v "$1")"
        else
            fail "$1 is not available"
        fi
    }
    need_file() {
        if [[ -f "$1" ]]; then
            ok "file exists: $1"
        else
            fail "missing file: $1"
        fi
    }

    printf '%s\n' 'Dotfiles doctor'
    need_cmd chezmoi

    if command -v chezmoi >/dev/null 2>&1; then
        data="$(chezmoi data --format=yaml 2>/dev/null || true)"
        if [[ -z "$data" ]]; then
            fail 'chezmoi data could not be read'
        else
            ok 'chezmoi data is readable'
            yaml_value() {
                printf '%s\n' "$data" | awk -F': ' -v key="$1" '$1 == key {print $2; exit}' | tr -d '\"'
            }
            platform="$(yaml_value platform)"
            profile="$(yaml_value machineProfile)"
            omarchy="$(yaml_value omarchy)"
            encryption="$(yaml_value useEncryption)"
            printf 'INFO platform=%s profile=%s omarchy=%s encryption=%s\n' \
                "${platform:-unknown}" "${profile:-unknown}" "${omarchy:-unknown}" "${encryption:-unknown}"
        fi
    else
        data=''
        platform=''
        profile=''
        omarchy=''
        encryption=''
    fi

    source_dir=''
    if command -v chezmoi >/dev/null 2>&1; then
        source_dir="$(chezmoi source-path 2>/dev/null || true)"
    fi
    if [[ -z "$source_dir" ]]; then
        source_dir="$PWD"
    fi
    if [[ -d "$source_dir/.git" ]]; then
        if [[ -n "$(git -C "$source_dir" status --short 2>/dev/null)" ]]; then
            warn "source tree has uncommitted changes: $source_dir"
        else
            ok "source tree is clean: $source_dir"
        fi
    else
        warn "source tree is not a Git worktree: $source_dir"
    fi

    if [[ "${encryption:-false}" == true ]]; then
        need_cmd age
        need_file "$HOME/.ssh/main"
        need_file "$HOME/.ssh/main.pub"
    else
        warn 'encryption is disabled in chezmoi data'
    fi

    if [[ "${platform:-}" == darwin ]]; then
        need_cmd brew
    fi
    need_cmd mise
    if [[ "${omarchy:-false}" != true ]]; then
        need_cmd aqua
    else
        printf '%s\n' 'INFO Omarchy detected; Aqua is intentionally not required here'
    fi

    if command -v herdr >/dev/null 2>&1; then
        ok "herdr: $(herdr --version 2>/dev/null | head -n 1)"
    else
        warn 'herdr is not installed on this machine'
    fi

    collie_env="$HOME/.config/herdr/plugins/config/herdr.collie/.env"
    if [[ -f "$collie_env" ]]; then
        ok 'Collie environment file exists (value contents not printed)'
    elif [[ "${profile:-}" == office-server ]]; then
        warn "office-server profile has no Collie environment file: $collie_env"
    fi

    if [[ "${DOTFILES_DOCTOR_DIFF:-0}" == 1 ]]; then
        if chezmoi diff --no-pager --exclude encrypted --refresh-externals=never >/dev/null 2>&1; then
            ok 'chezmoi diff completed without encrypted files'
        else
            fail 'chezmoi diff reported an error (encrypted files excluded)'
        fi
    else
        printf '%s\n' 'INFO set DOTFILES_DOCTOR_DIFF=1 to run the non-mutating diff check'
    fi

    printf 'Summary: %s failure(s), %s warning(s)\n' "$failures" "$warnings"
    if (( failures > 0 )); then
        exit 1
    fi

# Update chezmoi, Aqua, mise, Sheldon, and Homebrew
[group('utils')]
update-all:
    chezmoi update || true
    aqua install || true
    aqua vacuum --init || true
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum || true
    mise upgrade || true
    sheldon lock --update || true
    brew update && brew upgrade

# Full upgrade, including package cleanup
[group('utils')]
full-upgrade:
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 1/6: Updating chezmoi..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    chezmoi update || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 2/6: Installing pinned Aqua tools..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    aqua install || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 3/6: Cleaning old Aqua packages..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    aqua vacuum --init || true
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 4/6: Updating mise tools..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    mise upgrade || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 5/6: Updating Sheldon plugins..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    sheldon lock --update || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 6/6: Updating Homebrew..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    brew update && brew upgrade
    brew cleanup --prune=7
    @echo ""
    @echo "✓ Full upgrade complete!"

# Clean Homebrew caches and old versions
[group('utils')]
clean-all:
    aqua vacuum --init
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum
    brew cleanup --prune=7
