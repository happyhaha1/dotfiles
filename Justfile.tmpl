# just is a command runner, Justfile is very similar to Makefile, but simpler.

set shell := ['bash', '-euo', 'pipefail', '-c']

hostname := `hostname -s`

# List all the just commands
default:
    @just --list

############################################################################
#
#  Chezmoi related commands
#
############################################################################

# Apply chezmoi changes
[group('chezmoi')]
apply:
    chezmoi apply

# Edit chezmoi managed files
[group('chezmoi')]
edit file:
    chezmoi edit {{ "{{file}}" }}

# Show chezmoi diff
[group('chezmoi')]
diff:
    chezmoi diff

# Update chezmoi and apply
[group('chezmoi')]
update:
    chezmoi update

# Re-add modified files to chezmoi
[group('chezmoi')]
re-add:
    chezmoi re-add

# Install the declared Homebrew packages, casks, fonts, and App Store apps
[group('packages')]
bundle:
    brew bundle install --file="$HOME/.Brewfile"

# Install pinned Aqua tools
[group('packages')]
aqua-install:
    aqua install

# Remove Aqua package versions not used within the retention window.
# Override with AQUA_VACUUM_DAYS (default: 7).
[group('packages')]
aqua-clean:
    aqua vacuum --init
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum

# Install language runtimes and tools declared by mise
[group('packages')]
mise-install:
    mise install

############################################################################
#
#  Development commands
#
############################################################################

# Format chezmoi source files with treefmt
[group('dev')]
fmt:
    cd "$HOME/.local/share/chezmoi" && treefmt

# Run pre-commit checks
[group('dev')]
check:
    pre-commit run --all-files

############################################################################
#
#  Git related commands
#
############################################################################

# Git status
[group('git')]
st:
    git status

# Git diff
[group('git')]
gd:
    git diff

# Git log with graph
[group('git')]
gl:
    git log --oneline --graph --decorate -20

# Commit all changes with message
[group('git')]
cm message:
    git add -A && git commit -m "{{ "{{message}}" }}"

# Push to remote
[group('git')]
push:
    git push

# Pull from remote
[group('git')]
pull:
    git pull --rebase

############################################################################
#
#  Utility commands
#
############################################################################

# Show system info
[group('utils')]
info:
    @echo "Hostname: {{ "{{hostname}}" }}"
    @echo "OS: $(uname -s)"
    @echo "Arch: $(uname -m)"
    @brew --version 2>/dev/null || true
    @aqua --version 2>/dev/null || true
    @mise --version 2>/dev/null || true

# Update chezmoi, Aqua, mise, Sheldon, and Homebrew
[group('utils')]
update-all:
    chezmoi update || true
    aqua install || true
    aqua vacuum --init || true
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum || true
    mise upgrade || true
    sheldon lock --update || true
    brew update && brew upgrade

# Full upgrade, including package cleanup
[group('utils')]
full-upgrade:
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 1/6: Updating chezmoi..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    chezmoi update || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 2/6: Installing pinned Aqua tools..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    aqua install || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 3/6: Cleaning old Aqua packages..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    aqua vacuum --init || true
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 4/6: Updating mise tools..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    mise upgrade || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 5/6: Updating Sheldon plugins..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    sheldon lock --update || true
    @echo ""
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo "Step 6/6: Updating Homebrew..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    brew update && brew upgrade
    brew cleanup --prune=7
    @echo ""
    @echo "✓ Full upgrade complete!"

# Clean Homebrew caches and old versions
[group('utils')]
clean-all:
    aqua vacuum --init
    AQUA_VACUUM_DAYS="${AQUA_VACUUM_DAYS:-7}" aqua vacuum
    brew cleanup --prune=7
