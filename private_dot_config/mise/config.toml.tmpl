# mise global configuration
# https://mise.jdx.dev/configuration.html

[tools]
# Pi is installed from npm through mise on every platform. Its wrapper in
# ~/.local/bin resolves this package instead of shipping a second copy.
# Use npm as the installer; the embedded installer did not create Pi's bin.
"npm:@earendil-works/pi-coding-agent" = "1.3.0"

# Node.js (replaces volta)
node = "lts"

# pnpm (replaces corepack)
pnpm = "latest"

# Bun (replaces bunx)
bun = "latest"

{{ if eq .chezmoi.os "darwin" -}}
# DeepSeek Harness CLI (dsh); Paseo runs it as a custom ACP agent provider.
# Every published version on npm is a prerelease, and mise's npm backend filters
# prereleases out of its version list, so "latest" never resolves. Pin the exact
# version and bump it by hand: this tracks the npm "next" dist-tag
# (npm view @deepseek-ai/dsh@next version), newer than the "latest" tag.
"npm:@deepseek-ai/dsh" = "0.2.1-rc.2"
{{- end }}

# Terraform (replaces tenv)
#terraform = "latest"

# Python (for tools that need it)
python = "3.12"

# uv (Python package manager)
uv = "latest"

# Poetry (Python dependency manager, via pipx/uvx)
"pipx:poetry" = "latest"

# OpenViking CLI (ov) — talks to the OpenViking server on the NAS
"pipx:openviking" = "latest"

# Go
go = "latest"

# Rust
rust = "latest"

{{ if eq .chezmoi.os "darwin" -}}
# Python CLI tools (via pipx) - macOS only
"pipx:mac-cleanup" = "latest"
{{ end -}}

# pre-commit
pre-commit = "latest"

usage = "latest"
java = "zulu-javafx-8.92.0.21"

[settings]
# Automatically install declared tools when entering a project.
auto_install = true

# Use idiomatic version files (.node-version, .python-version, etc.)
idiomatic_version_file = true

# Experimental features
experimental = true

# Trust specific project paths (more secure than trusting ~)
# Add your trusted project directories here
trusted_config_paths = [
    "~/Documents/Projects",
    "~/Documents/Work",
]

# Always keep latest versions
always_keep_download = false
always_keep_install = false

[settings.npm]
package_manager = "npm"

# Remove older tool versions after mise upgrades on every platform.
[settings.upgrade]
auto_prune = true

[env]
# Add local bin to PATH
#_.path = ["./node_modules/.bin", "./bin"]
