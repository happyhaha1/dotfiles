# Session-wide environment for commands launched directly by Hyprland/UWSM.
# This also affects shortcuts such as Super+Shift+Ctrl+A -> Pi and
# Super+Ctrl+Enter -> Herdr; those commands do not start Fish first.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Put Aqua-managed Omarchy CLI proxies before system binaries.
export PATH="${AQUA_ROOT_DIR:-$XDG_DATA_HOME/aquaproj-aqua}/bin:$PATH"
export AQUA_CONFIG="$XDG_CONFIG_HOME/aquaproj-aqua/aqua-omarchy.yaml"
export AQUA_GLOBAL_CONFIG="$AQUA_CONFIG"
export AQUA_POLICY_CONFIG="$XDG_CONFIG_HOME/aquaproj-aqua/aqua-policy.yaml"

export EDITOR=nvim
export VISUAL=nvim
export SUDO_EDITOR=nvim
