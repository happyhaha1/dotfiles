{{- if or (not (hasKey . "roamgateHost")) (eq .roamgateHost "") -}}
{{- fail "Roamgate requires machine-local roamgateHost" -}}
{{- end -}}
{{- if not (regexMatch "^[A-Za-z0-9_.:\\[\\]-]+$" .roamgateHost) -}}
{{- fail "Roamgate host must be a literal hostname/address" -}}
{{- end -}}
# Private Roamgate service configuration.
# The host is machine-local data; never commit its value.
HOST={{ .roamgateHost | quote }}
PORT=8788

# Set [data].roamgatePassword with `chezmoi edit-config` for automatic sync.
# Manual service installation can still generate an auth-token if omitted.
{{ if and (hasKey . "roamgatePassword") (ne .roamgatePassword "") -}}
{{- if regexMatch "[[:cntrl:]]" .roamgatePassword -}}
{{- fail "Roamgate password must contain no control characters" -}}
{{- end -}}
# Escape shell metacharacters for launchd and systemd, without evaluating them.
ROAMGATE_PASSWORD="{{ .roamgatePassword | replace "\\" "\\\\" | replace "\"" "\\\"" | replace "$" "\\$" | replace "`" "\\`" }}"
{{ end -}}
