# Private Roamgate service configuration.
# The host is machine-local data; never commit its value.
HOST={{ .roamgateHost }}
PORT=8788

# Set [data].roamgatePassword with `chezmoi edit-config`.
# If omitted, Roamgate generates ~/.config/roamgate/auth-token instead.
{{ if and (hasKey . "roamgatePassword") (ne .roamgatePassword "") }}
ROAMGATE_PASSWORD="{{ .roamgatePassword }}"
{{ end }}
