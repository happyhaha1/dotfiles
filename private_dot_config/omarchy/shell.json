{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.manateelazycat.window-switcher"
        }
      ],
      "center": [
        {
          "id": "local.days"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Shanghai",
              "zone": "Asia/Shanghai"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            }
          ]
        },
        {
          "id": "harshith.system-monitor",
          "barMode": "Adaptive"
        },
        {
          "id": "io.github.elevate08.qs-bitwarden-cli"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "metasequoia.msime"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "jankeesvw.notification-center"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.system-update"
        }
      ],
      "tray": []
    }
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "tourSeen": true,
      "openAs": "panel",
      "design": "editorial"
    }
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.workspaces"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer",
    "io.github.manateelazycat.window-switcher"
  ]
}
