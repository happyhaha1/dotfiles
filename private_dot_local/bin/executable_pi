#!/usr/bin/env bash
set -euo pipefail

# Pi is managed by the Omarchy Aqua subset. This wrapper keeps Omarchy's
# default-agent detection from falling back to `mise use -g pi` after the
# official preinstall wrapper is removed.
aqua_bin_dir="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin"
aqua_config="${AQUA_CONFIG:-}"
if [[ -z "$aqua_config" ]]; then
    if [[ -f "$HOME/.config/aquaproj-aqua/aqua-omarchy.yaml" ]]; then
        aqua_config="$HOME/.config/aquaproj-aqua/aqua-omarchy.yaml"
    else
        aqua_config="$HOME/.config/aquaproj-aqua/aqua.yaml"
    fi
fi

export AQUA_CONFIG="$aqua_config"
export AQUA_GLOBAL_CONFIG="${AQUA_GLOBAL_CONFIG:-$aqua_config}"
if [[ -f "$HOME/.config/aquaproj-aqua/aqua-policy.yaml" ]]; then
    export AQUA_POLICY_CONFIG="${AQUA_POLICY_CONFIG:-$HOME/.config/aquaproj-aqua/aqua-policy.yaml}"
fi
export PATH="$aqua_bin_dir:$PATH"

if [[ ! -x "$aqua_bin_dir/pi" ]]; then
    echo "pi is managed by Aqua, but $aqua_bin_dir/pi is missing." >&2
    echo "Run: chezmoi apply" >&2
    exit 127
fi

exec "$aqua_bin_dir/pi" "$@"
