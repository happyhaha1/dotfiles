#!/usr/bin/env bash
set -euo pipefail

# Resolve global tools from home without changing Pi's working directory.
pi_root="$(cd "$HOME" && mise where npm:@earendil-works/pi-coding-agent)"
node_cmd="$(cd "$HOME" && mise which node)"
if [[ ! -f "$pi_root/bin/pi" || ! -x "$node_cmd" ]]; then
    echo "Pi or Node is missing. Run: mise install" >&2
    exit 127
fi
exec "$node_cmd" "$pi_root/bin/pi" "$@"
