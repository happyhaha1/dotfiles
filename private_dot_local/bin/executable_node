#!/usr/bin/env bash
set -euo pipefail

# Herdr's background PATH does not include mise's Node directory. Keep the
# Web UI's terminal sidecar discoverable without a second runtime install.
mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
node_bin="$mise_data_dir/installs/node/lts/bin/node"

if [[ ! -x "$node_bin" ]]; then
    echo "Node is managed by mise, but $node_bin is missing." >&2
    echo "Run: mise install node@lts" >&2
    exit 127
fi

exec "$node_bin" "$@"
