#!/usr/bin/env bash
set -euo pipefail

# Herdr's macOS background server does not inherit mise's interactive PATH.
# Keep `bun` discoverable from ~/.local/bin while mise remains the source of
# the runtime and its version.
mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
bun_bin="$mise_data_dir/installs/bun/latest/bin/bun"

if [[ ! -x "$bun_bin" ]]; then
    echo "Bun is managed by mise, but $bun_bin is missing." >&2
    echo "Run: mise install bun@latest" >&2
    exit 127
fi

exec "$bun_bin" "$@"
