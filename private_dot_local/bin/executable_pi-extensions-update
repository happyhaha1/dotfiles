#!/usr/bin/env bash
set -euo pipefail

echo ":: Updating Pi user extension packages"
pi_agent_dir="${PI_CODING_AGENT_DIR-$HOME/.pi/agent}"
if [[ ! -d "$pi_agent_dir" ]]; then
    echo "    Skipped (Pi agent directory does not exist)"
    exit 0
fi
if [[ ! -f "$pi_agent_dir/settings.json" ]]; then
    echo "    Skipped (Pi has no user settings declaring packages)"
    exit 0
fi
if ! command -v mise >/dev/null 2>&1; then
    echo "    Skipped (mise is not installed)"
    exit 0
fi
pi_root="$(cd "$HOME" && mise where npm:@earendil-works/pi-coding-agent)"
if [[ ! -f "$pi_root/bin/pi" ]]; then
    echo "    Skipped (mise-managed Pi payload is not installed)"
    exit 0
fi
node_cmd="$(cd "$HOME" && mise which node)"
# Update user extensions only; leave mise's Pi version and running sessions alone.
exec "$node_cmd" "$pi_root/bin/pi" update --extensions --no-approve
