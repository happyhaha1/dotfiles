#!/bin/bash
# Tern 启动其助手（Carly）时只透传一份白名单环境（HOME PATH PWD SHELL 等 19 个
# 变量），所以 Aqua 需要的变量与 provider 需要的密钥都在这里补齐，再交给 Aqua 的
# 代理。写法沿用 private_dot_local/bin/executable_herdr：先导出 AQUA_*，再委托。
set -euo pipefail

aqua_root="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}"
proxy="$aqua_root/aqua-proxy"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua"
config="$config_dir/aqua.yaml"
policy="$config_dir/aqua-policy.yaml"
secrets="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/secrets.fish"

if [[ ! -x "$proxy" ]]; then
    echo "omp: Aqua proxy not found: $proxy" >&2
    exit 127
fi
if [[ ! -f "$config" ]]; then
    echo "omp: Aqua config not found: $config" >&2
    exit 127
fi

export AQUA_CONFIG="$config"
export AQUA_GLOBAL_CONFIG="${AQUA_GLOBAL_CONFIG:-$config}"
if [[ -f "$policy" ]]; then
    export AQUA_POLICY_CONFIG="${AQUA_POLICY_CONFIG:-$policy}"
fi

# secrets.fish 是这台机器上密钥的唯一来源（chezmoi 加密托管）；白名单环境丢掉了
# 它导出的变量。只接受 `set -gx NAME VALUE` 字面量行；含命令替换或空格的行跳过
# （不能在此求值）。
if [[ -f "$secrets" ]]; then
    while read -r _ _ name value; do
        case "$name" in
            ''|*[!A-Za-z0-9_]*) continue ;;
        esac
        case "$value" in
            ''|*'('*|*' '*|*'$'*) continue ;;
        esac
        value="${value%\'}"; value="${value#\'}"
        value="${value%\"}"; value="${value#\"}"
        [[ -n "$value" ]] || continue
        export "$name=$value"
    done < <(grep -E '^[[:space:]]*set[[:space:]]+-[a-zA-Z]*x[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]+' "$secrets" || true)
fi

exec -a "${0##*/}" "$proxy" "$@"
